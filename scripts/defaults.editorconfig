# Default EditorConfig used when the target repository has no .editorconfig.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
max_line_length = 80

[*.py]
indent_size = 4

[CMakeLists.txt]
indent_size = 4

[*.{yaml,yml,json}]
max_line_length = off
